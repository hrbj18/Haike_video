{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haike.local/schemas/material_vision_eval.schema.json",
  "title": "素材视觉理解验收集",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "corpus_id", "sources", "cases"],
  "properties": {
    "version": {"const": 1},
    "corpus_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "maxLength": 1000},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "fingerprint"],
        "properties": {
          "asset_id": {"type": "string", "minLength": 1, "maxLength": 120},
          "fingerprint": {"type": "string", "minLength": 8, "maxLength": 128},
          "relative_path": {"type": "string", "maxLength": 500}
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "asset_id", "expected_intervals"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1, "maxLength": 120},
          "asset_id": {"type": "string", "minLength": 1, "maxLength": 120},
          "mode": {"enum": ["vision_only", "mixed", "screen_text", "speech"]},
          "expected_intervals": {"$ref": "#/$defs/intervals"},
          "forbidden_intervals": {"$ref": "#/$defs/intervals"},
          "required_entities": {"$ref": "#/$defs/labels"},
          "required_actions": {"$ref": "#/$defs/labels"},
          "forbidden_claims": {"$ref": "#/$defs/labels"}
        }
      }
    }
  },
  "$defs": {
    "labels": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 160}
    },
    "intervals": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "number", "minimum": 0},
          {"type": "number", "exclusiveMinimum": 0}
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    }
  }
}
