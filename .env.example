# Haike Video - Environment Variables
# Copy this to .env.local and fill in your keys; never commit the local file

# --- Image + video gateway ---
# FLUX images, Google Veo video, Kling video, MiniMax video, Recraft images.
# Get one at https://fal.ai/dashboard/keys
FAL_KEY=
# Alias for FAL_KEY (some SDKs/docs use this name); either one is read.
FAL_AI_API_KEY=

# --- Replicate ---
# Replicate-hosted video gen (seedance_replicate). Needed to make the
# Replicate-backed Seedance path selectable alongside the fal.ai one.
# Get one at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# --- Higgsfield ---
# Higgsfield Cloud key (higgsfield_video). Pair with the secret below,
# or use the combined HIGGSFIELD_KEY="<key>:<secret>" form instead.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# HIGGSFIELD_KEY=            # Combined key:secret — set this INSTEAD of the _KEY/_SECRET pair if you prefer.

# --- Kling official direct API ---
# Official Kling API key; enables video, image, TTS, avatar, lip sync.
KLING_API_KEY=
# Optional endpoint override; leave blank for default https://api-singapore.klingai.com
# Mainland China accounts can use https://api-beijing.klingai.com
KLING_API_BASE_URL=

# --- Google (one key unlocks image gen + TTS + video) ---
# Google Imagen images, Google Cloud TTS (700+ voices, 50+ languages),
# Gemini Omni video (generation + conversational editing, paid tier).
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# GEMINI_API_KEY=            # Alias for GOOGLE_API_KEY (takes precedence when both are set)
# Alternative to the API key: service-account JSON auth.
# TTS uses Cloud Text-to-Speech; Imagen routes to Vertex AI.
# Path to a service-account JSON key file.
GOOGLE_APPLICATION_CREDENTIALS=
# GCP project id (required for Imagen via Vertex AI).
GOOGLE_CLOUD_PROJECT=
# Vertex AI region, default us-central1.
GOOGLE_CLOUD_LOCATION=

# --- Voice ---
# TTS narration, music generation, sound effects.
ELEVENLABS_API_KEY=
# OpenAI TTS fallback and GPT Image 2 image generation.
OPENAI_API_KEY=
# Optional OpenAI-compatible gateway, e.g. https://gateway.example/v1.
# Leave blank to call the official API endpoint.
OPENAI_BASE_URL=
# Primary text model; use a model returned by the gateway's /models endpoint.
OPENAI_TEXT_MODEL=
# Legacy fallback name kept for older local configurations.
OPENAI_SCRIPT_MODEL=
# --- Doubao (火山方舟) 文本模型：写台词专用 ---
# 与主文本模型共用 OpenAI 兼容协议，但走独立密钥与端点。未配置时，
# 写台词自动回落主模型（gpt-5.6-luna），不影响生产。
DOUBAO_API_KEY=
# 默认 https://ark.cn-beijing.volces.com/api/v3
DOUBAO_BASE_URL=
# 默认 doubao-seed-2-1-pro-260628（火山方舟直连，需在控制台开通该模型服务）
DOUBAO_TEXT_MODEL=
# Grok image generation/editing and Grok video generation.
XAI_API_KEY=
# Volcengine Doubao Speech TTS (new console API Key).
DOUBAO_SPEECH_API_KEY=
# Default Doubao speaker/voice type, e.g. zh_female_vv_uranus_bigtts.
DOUBAO_SPEECH_VOICE_TYPE=
# Optional role mapping exposed in the Haike Video audio centre. Keep actual
# account-bound voice ids in .env.local or .env.secrets.local, never in Git.
DOUBAO_SPEECH_YAYA_VOICE_TYPE=
DOUBAO_SPEECH_YAYA_RESOURCE_ID=
DOUBAO_SPEECH_YAYA_ENABLED=1
DOUBAO_SPEECH_MENGMENG_VOICE_TYPE=
DOUBAO_SPEECH_MENGMENG_RESOURCE_ID=
DOUBAO_SPEECH_MENGMENG_ENABLED=1
# Optional verified public fallback; keep it visibly separate from cloned roles.
DOUBAO_SPEECH_PUBLIC_VOICE_TYPE=
DOUBAO_SPEECH_PUBLIC_RESOURCE_ID=seed-tts-2.0
DOUBAO_SPEECH_PUBLIC_ENABLED=1
# auto, voicebox_tts, or doubao. The selected profile is frozen per task.
HAIKE_VIDEO_TTS_PROVIDER=auto
# Piper local voices do not require env vars; install `piper-tts` via pip

# --- DashScope (Alibaba Cloud Bailian) ---
# Qwen image gen (qwen-image-2.0-pro), TTS (qwen3-tts-flash), ASR with word timestamps (qwen3-asr-flash-filetrans).
# Get one at https://dashscope.aliyun.com/
DASHSCOPE_API_KEY=
# 阿里云百炼工作空间 ID（wan2.2-s2v 使用北京地域工作空间）
DASHSCOPE_WORKSPACE_ID=

# --- RunningHub digital human (InfiniteTalk exact frame-clock workflow) ---
# Consumer/enterprise API key. Store real values in .env.secrets.local only.
RUNNINGHUB_API_KEY=
# Numeric id of the workflow published in RunningHub. The downloaded API JSON
# does not contain this id; copy it from the published workflow page/API panel.
RUNNINGHUB_WORKFLOW_ID=2094449979141218305
RUNNINGHUB_BASE_URL=https://www.runninghub.cn
RUNNINGHUB_WORKFLOW_TEMPLATE=config/runninghub/workflow-2094449979141218305.api.json
RUNNINGHUB_WORKFLOW_PROFILE=infinitetalk_448x560_exact_clock_v2

# --- Music ---
# Suno AI music generation (full songs, instrumentals, any genre).
SUNO_API_KEY=

# --- 抖音素材信号（可选） ---
# 抖音热榜/对标账号只做"选题热度排序"信号，不充当事实证据。
# 配置此密钥并在 config/daily_tech_brief.json 填写 HTTPS api_url 后优先请求 API；
# API 失败会回落 config/douyin_snapshots/ 快照，两者都不可用则非致命跳过。
DOUYIN_API_KEY=
# Optional external copy_skill candidate-pack directory. Leave blank to disable.
COPY_SKILL_HOTSPOT_ROOT=

# --- Video Generation ---
# HeyGen API (VEO, Sora, Runway, Kling, Seedance via single key).
HEYGEN_API_KEY=
# Runway Gen-4 (direct API, alternative to fal.ai routing).
RUNWAY_API_KEY=
# Volcengine Jimeng (即梦 AI) video generation via official API (HMAC-SHA256 V4 signing).
VOLC_ACCESSKEY=
# Secret Access Key paired with VOLC_ACCESSKEY. Get both at https://console.volcengine.com/iam/keymanage
VOLC_SECRETKEY=
# Set to "true" for local video gen (needs GPU + diffusers).
VIDEO_GEN_LOCAL_ENABLED=
# Local model: wan2.1-1.3b, wan2.1-14b, hunyuan-1.5, ltx2-local, cogvideo-5b.
VIDEO_GEN_LOCAL_MODEL=
# Modal self-hosted LTX-2 endpoint (optional).
MODAL_LTX2_ENDPOINT_URL=

# --- Stock Media ---
# Pexels stock footage/images (free).
PEXELS_API_KEY=
# Pixabay stock footage/images (free).
PIXABAY_API_KEY=
# Unsplash stock images (free developer key).
UNSPLASH_ACCESS_KEY=

# --- Analysis ---
# HuggingFace token — enables speaker diarization in transcriber.
HF_TOKEN=
# Speech-to-text: optional Azure AI Speech (Fast Transcription). When set, the
# agent prefers azure_stt for cloud STT; the local faster-whisper transcriber
# remains the default offline path.
# Azure AI Speech resource key ('Keys and Endpoint' page).
AZURE_SPEECH_KEY=
# Speech resource region, e.g. eastus.
AZURE_SPEECH_REGION=
# AZURE_SPEECH_ENDPOINT=     # Optional: full custom endpoint URL (overrides region)

# --- Avatar (local installs) ---
# WAV2LIP_PATH=              # Path to cloned Wav2Lip repo (for lip sync)
# SADTALKER_PATH=            # Path to cloned SadTalker repo (for talking head avatars)

# --- Haike Video workspace ---
# These paths are optional. By default everything resolves relative to this repository.
# Use absolute paths only for a deliberately external media library.
HAIKE_VIDEO_CONTENT_ROOT=content
HAIKE_VIDEO_PROJECT_SOURCE_ROOT=content/episodes
HAIKE_VIDEO_LIBRARY_ROOT=content/library
HAIKE_VIDEO_TEMPLATES_ROOT=content/templates
HAIKE_VIDEO_RUNTIME_ROOT=projects
HAIKE_VIDEO_RENDER_ROOT=renders
HAIKE_VIDEO_CACHE_ROOT=cache
HAIKE_VIDEO_TEMP_ROOT=temp

# --- Haike Video embedded local TTS (Qwen3-TTS) ---
# Run scripts/setup_local_tts.ps1 once. Models download into ignored local data on first use.
HAIKE_VIDEO_TTS_BASE_URL=http://127.0.0.1:17494
HAIKE_VIDEO_TTS_DATA_DIR=
HAIKE_VIDEO_TTS_MODEL_CACHE=
HAIKE_VIDEO_TTS_DEVICE=auto
HAIKE_VIDEO_TTS_MAX_LOADED_MODELS=1
HAIKE_VIDEO_TTS_MAX_CHARS=500
HAIKE_VIDEO_TTS_PROFILE_NAME=Qwen Serena
HAIKE_VIDEO_TTS_PROFILE_ID=
HAIKE_VIDEO_TTS_LANGUAGE=zh
# Optional role overrides for unattended dual-host narration.
HAIKE_VIDEO_TTS_YAYA_PROFILE_ID=
HAIKE_VIDEO_TTS_MENGMENG_PROFILE_ID=
